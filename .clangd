# Point clangd at Homebrew GCC so <bits/stdc++.h> and GCC's libstdc++ resolve.
# Requires clangd to be started with --query-driver=/opt/homebrew/bin/g++-*
# (set in ~/.config/nvim/lua/plugins/competitest.lua).
CompileFlags:
  Compiler: /opt/homebrew/bin/g++-16
  Add: [-std=c++20, -Wall, -Wextra, -DLOCAL]
